#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
new-project — create a new repo under /mnt/c/Users/alexa/Projects and publish to GitHub

Usage:
  scripts/new-project --name <repo-name> [options]

Required:
  --name, -n            Repository name (recommended: kebab-case)

Options:
  --visibility          private|public (default: private)
  --stack               Free-form tech stack string used to seed CLAUDE.md
  --description         Short description for README (optional)
  --projects-dir        Base directory (default: /mnt/c/Users/alexa/Projects)
  --license             mit|none (default: mit)
  --owner               GitHub owner/org (default: $AGENT_SCRIPTS_OWNER or alexperreira)
  --no-remote           Skip GitHub remote creation/push (local-only)
  --dry-run             Print actions without writing
  --help, -h            Show this help

Environment (overridden by the flags above; used as defaults):
  AGENT_SCRIPTS_PROJECTS_DIR  Base directory          (default: /mnt/c/Users/alexa/Projects)
  AGENT_SCRIPTS_OWNER         GitHub owner/org        (default: alexperreira)
  AGENT_SCRIPTS_AUTHOR        Author name for LICENSE (default: Alex Perreira)
  AGENT_SCRIPTS_WEBSITE       Site/blog URL           (default: alexhacks.net)

Examples:
  scripts/new-project --name my-tool --stack "typescript, node, pnpm" --visibility private
  scripts/new-project -n my-lib --stack "python, uv, pytest" --visibility public
  scripts/new-project -n my-app --stack "expo, react-native" --visibility private
  scripts/new-project -n scratch --no-remote --projects-dir /tmp --dry-run
EOF
}

is_kebab_case() {
  [[ "${1}" =~ ^[a-z0-9]+([-.][a-z0-9]+)*$ ]]
}

escape_sed_replacement() {
  local value="${1//\\/\\\\}"
  value="${value//&/\\&}"
  value="${value//\//\\/}"
  printf '%s' "$value"
}

render_template() {
  # $1 = template path, $2 = output path
  # Replaces {{VAR}} tokens with corresponding env vars.
  local template_path="$1"
  local output_path="$2"
  local esc_project_name
  local esc_description
  local esc_tech_stack
  local esc_author
  local esc_github_owner
  local esc_website
  local esc_date_today

  esc_project_name="$(escape_sed_replacement "$PROJECT_NAME")"
  esc_description="$(escape_sed_replacement "$DESCRIPTION")"
  esc_tech_stack="$(escape_sed_replacement "$TECH_STACK")"
  esc_author="$(escape_sed_replacement "$AUTHOR")"
  esc_github_owner="$(escape_sed_replacement "$GITHUB_OWNER")"
  esc_website="$(escape_sed_replacement "$WEBSITE")"
  esc_date_today="$(escape_sed_replacement "$DATE_TODAY")"

  local sed_expr=()
  sed_expr+=("-e" "s/{{PROJECT_NAME}}/${esc_project_name}/g")
  sed_expr+=("-e" "s/{{DESCRIPTION}}/${esc_description}/g")
  sed_expr+=("-e" "s/{{TECH_STACK}}/${esc_tech_stack}/g")
  sed_expr+=("-e" "s/{{YEAR}}/${YEAR}/g")
  sed_expr+=("-e" "s/{{AUTHOR}}/${esc_author}/g")
  sed_expr+=("-e" "s/{{GITHUB_OWNER}}/${esc_github_owner}/g")
  sed_expr+=("-e" "s/{{WEBSITE}}/${esc_website}/g")
  sed_expr+=("-e" "s/{{DATE_TODAY}}/${esc_date_today}/g")

  sed "${sed_expr[@]}" "$template_path" >"$output_path"
}

# stack_has TOKEN... — true if --stack names any of these as a whole word.
# Substring matching silently appended the wrong quickstart: "py" matched
# numpy, "uv" matched uvicorn, "ts" matched components and tests. The stack
# string is split on anything that is not alphanumeric/+/#/. so that
# "react-native", "react native" and "React Native" all tokenise the same.
stack_has() {
  local s t
  s="$(printf ',%s,' "$(printf '%s' "${TECH_STACK}" \
        | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9+#.' ',')" | tr -s ',')"
  for t in "$@"; do
    [[ "$s" == *",${t},"* ]] && return 0
  done
  return 1
}

should_include_node_section() {
  stack_has ts typescript js javascript node nodejs pnpm npm yarn bun
}

should_include_python_section() {
  stack_has py python python3 pytest uv pip poetry ruff django flask fastapi
}

should_include_mobile_section() {
  stack_has expo mobile ios android || { stack_has react && stack_has native; }
}

append_mobile_section() {
  local claude_path="$1"

  if should_include_mobile_section; then
    cat <<'EOF' >>"$claude_path"

## Mobile App Stack

This is an Expo/React Native project. Reference these commands when relevant:
- /expo-project-scaffold — for new project setup
- /rn-component-patterns — for screen/component architecture
- /rn-platform-gotchas — for cross-platform issues
- /expo-build-deploy — for builds, OTA, and store submission
EOF
  fi
}

append_stack_sections() {
  local claude_path="$1"

  {
    echo
    echo "## Commands (fill in as you go)"
    echo
    echo '```bash'
    if should_include_node_section; then
      cat <<'EOF'
# Development
pnpm install                # Install dependencies
pnpm dev                    # Start dev server
pnpm build                  # Production build

# Quality
pnpm lint                   # Lint
pnpm typecheck              # TypeScript check (no emit)
pnpm test                   # Run tests
EOF
    fi

    if should_include_python_section; then
      cat <<'EOF'
# Setup
python -m venv .venv && source .venv/bin/activate
pip install -r requirements.txt   # or: uv sync

# Quality
ruff check .                # Lint
pytest -q                   # Run tests
EOF
    fi
    echo '```'
    echo
    cat <<'EOF'
### Notes
- This repo lives under `/mnt/c` so Windows-side tools can see it. That costs
  some filesystem speed; if a build is I/O-bound, move only the build cache
  (`node_modules`, `.venv`, `target/`) onto ext4 rather than relocating the repo.
- `core.fileMode` is disabled here: `/mnt/c` cannot represent the executable
  bit, so git would otherwise report every file as changed. Set a script's mode
  in the index with `git update-index --chmod=+x <path>`.
- Update commands above with concrete values once the stack stabilizes.
EOF
  } >>"$claude_path"
}

PROJECT_NAME=""
VISIBILITY="private"
TECH_STACK=""
DESCRIPTION=""
PROJECTS_DIR="${AGENT_SCRIPTS_PROJECTS_DIR:-/mnt/c/Users/alexa/Projects}"
LICENSE_KIND="mit"
GITHUB_OWNER="${AGENT_SCRIPTS_OWNER:-alexperreira}"
CREATE_REMOTE="true"
DRY_RUN="false"

AUTHOR="${AGENT_SCRIPTS_AUTHOR:-Alex Perreira}"
WEBSITE="${AGENT_SCRIPTS_WEBSITE:-alexhacks.net}"
YEAR="$(date +%Y)"
DATE_TODAY="$(date +%Y-%m-%d)"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name|-n)
      require_arg_value "$1" "${2:-}"
      PROJECT_NAME="${2:-}"; shift 2 ;;
    --visibility)
      require_arg_value "$1" "${2:-}"
      VISIBILITY="${2:-}"; shift 2 ;;
    --stack)
      require_arg_value "$1" "${2:-}"
      TECH_STACK="${2:-}"; shift 2 ;;
    --description)
      require_arg_value "$1" "${2:-}"
      DESCRIPTION="${2:-}"; shift 2 ;;
    --projects-dir)
      require_arg_value "$1" "${2:-}"
      PROJECTS_DIR="${2:-}"; shift 2 ;;
    --license)
      require_arg_value "$1" "${2:-}"
      LICENSE_KIND="${2:-}"; shift 2 ;;
    --owner)
      require_arg_value "$1" "${2:-}"
      GITHUB_OWNER="${2:-}"; shift 2 ;;
    --no-remote)
      CREATE_REMOTE="false"; shift ;;
    --dry-run)
      DRY_RUN="true"; shift ;;
    --help|-h)
      usage; exit 0 ;;
    *)
      die "unknown argument: $1" ;;
  esac
done

[[ -n "$PROJECT_NAME" ]] || die "--name is required"
is_kebab_case "$PROJECT_NAME" || echo "note: '$PROJECT_NAME' is not kebab-case; continuing anyway." >&2

case "$VISIBILITY" in
  private|public) ;;
  *) die "--visibility must be 'private' or 'public' (got: $VISIBILITY)" ;;
esac

case "$LICENSE_KIND" in
  mit|none) ;;
  *) die "--license must be 'mit' or 'none' (got: $LICENSE_KIND)" ;;
esac

TARGET_DIR="${PROJECTS_DIR}/${PROJECT_NAME}"

echo "Project: ${PROJECT_NAME}"
echo "Dir:     ${TARGET_DIR}"
echo "Remote:  https://github.com/${GITHUB_OWNER}/${PROJECT_NAME}.git"
echo "Public:  ${VISIBILITY}"
echo "Stack:   ${TECH_STACK:-<unspecified>}"
echo "License: ${LICENSE_KIND}"
echo

# ── Preconditions ────────────────────────────────────────────────────────────
# All of these run BEFORE mkdir, and before the dry-run exit. Previously
# `require_cmd gh` sat after the directory, every rendered file and the initial
# commit already existed, so a missing gh or expired auth left a half-built
# project that the retry then refused to touch ("target already exists"). It
# also made --dry-run a preview that could not fail, while the skill says to
# always dry-run first.
require_cmd git
require_cmd sed
require_cmd date

TEMPLATE_DIR="${SCRIPT_DIR}/../templates/empty"
[[ -d "$TEMPLATE_DIR" ]] || die "missing templates: $TEMPLATE_DIR"

[[ ! -e "$TARGET_DIR" ]] || die "target already exists: $TARGET_DIR"

# `git commit` below will not inherit an identity from this repo — the new
# project is a separate tree. Advisory rather than fatal: git falls back to
# user@hostname (with a warning) unless user.useConfigOnly is set, so an unset
# user.email does not reliably mean the commit will fail. If it does fail, the
# cleanup trap below removes the partial tree, which is the outcome finding 5
# was actually about.
if ! git config --global --get user.email >/dev/null 2>&1 \
   && ! git config --system --get user.email >/dev/null 2>&1; then
  warn "no global git user.email; the initial commit will use git's fallback identity."
  warn "set one with: git config --global user.email <you@example.com>"
fi

if [[ "$CREATE_REMOTE" == "true" ]]; then
  require_cmd gh
  gh auth status >/dev/null 2>&1 \
    || die "gh is not authenticated; run: gh auth login   (or pass --no-remote)"
fi

if [[ "$DRY_RUN" == "true" ]]; then
  echo "[dry-run] Would create directory and files (including docs/MEASUREMENT.md)"
  echo "[dry-run] Would init git + initial commit"
  if [[ "$CREATE_REMOTE" == "true" ]]; then
    echo "[dry-run] Would create GitHub repo via gh + push"
  else
    echo "[dry-run] Skipping GitHub remote creation"
  fi
  echo "[dry-run] Preconditions checked: tooling, templates, free target path, gh auth (unless --no-remote)"
  exit 0
fi

# From here on the directory exists. If anything fails, remove the tree this
# run created rather than leaving a half-built project the retry cannot
# overwrite. Only ever removes a path this script just made.
CREATED_TARGET="false"
cleanup_partial() {
  local rc=$?
  if [[ $rc -ne 0 && "$CREATED_TARGET" == "true" ]]; then
    warn "failed partway through; removing the partial project at ${TARGET_DIR}"
    rm -rf -- "$TARGET_DIR"
  fi
  return $rc
}
trap cleanup_partial EXIT

mkdir -p "$TARGET_DIR"
CREATED_TARGET="true"

mkdir -p "${TARGET_DIR}/docs/active" "${TARGET_DIR}/docs/archive"
touch "${TARGET_DIR}/docs/active/.gitkeep"
touch "${TARGET_DIR}/docs/archive/.gitkeep"

if [[ -z "$DESCRIPTION" ]]; then
  DESCRIPTION="New project: ${PROJECT_NAME}"
fi

render_template "${TEMPLATE_DIR}/README.md.tmpl" "${TARGET_DIR}/README.md"
render_template "${TEMPLATE_DIR}/gitignore.tmpl" "${TARGET_DIR}/.gitignore"
render_template "${TEMPLATE_DIR}/CLAUDE.md.tmpl" "${TARGET_DIR}/CLAUDE.md"
append_stack_sections "${TARGET_DIR}/CLAUDE.md"
append_mobile_section "${TARGET_DIR}/CLAUDE.md"
render_template "${TEMPLATE_DIR}/MEASUREMENT.md.tmpl" "${TARGET_DIR}/docs/MEASUREMENT.md"

if [[ "$LICENSE_KIND" == "mit" ]]; then
  render_template "${TEMPLATE_DIR}/LICENSE-MIT.tmpl" "${TARGET_DIR}/LICENSE"
fi

(
  cd "$TARGET_DIR"
  git init -b main >/dev/null
  # /mnt/c cannot represent the executable bit, so without this git reports
  # every file as modified — the 33-file mode incident.
  case "$TARGET_DIR" in
    /mnt/*) git config core.fileMode false ;;
  esac
  # `git add -A` is the one place this repo stages wholesale rather than by
  # path. It is correct here: the tree was created moments ago by this script
  # and contains nothing else.
  git add -A
  git commit -m "chore: init ${PROJECT_NAME}" >/dev/null
)

if [[ "$CREATE_REMOTE" == "true" ]]; then
  require_cmd gh
  (
    cd "$TARGET_DIR"
    if [[ "$VISIBILITY" == "private" ]]; then
      gh repo create "${GITHUB_OWNER}/${PROJECT_NAME}" --private --source=. --remote=origin --push
    else
      gh repo create "${GITHUB_OWNER}/${PROJECT_NAME}" --public --source=. --remote=origin --push
    fi
  )

  # Register in current-projects so sync-projects can track it
  REGISTRY="${SCRIPT_DIR}/../current-projects"
  SLUG="${GITHUB_OWNER}/${PROJECT_NAME}"
  if [[ -f "$REGISTRY" ]]; then
    # Match on the first field only. Registry lines may carry a placement
    # column, so a whole-line match against the bare slug misses
    # "owner/repo<TAB>ext4" and appends a duplicate entry for the same repo.
    if awk '{ sub(/#.*/, ""); print $1 }' "$REGISTRY" | grep -qxF "$SLUG"; then
      echo "note: ${SLUG} already in current-projects."
    else
      # Without this guard, appending to a file that does not end in a newline
      # produces "owner/oldrepoowner/newrepo" on one line, making BOTH repos
      # invisible to sync-projects.
      if [[ -s "$REGISTRY" && -n "$(tail -c1 "$REGISTRY")" ]]; then
        printf '\n' >> "$REGISTRY"
      fi
      # Record where the repo was actually scaffolded. Appending a bare slug
      # for a repo created outside the default root makes sync-projects clone a
      # SECOND copy onto /mnt/c — the divergence ADR-0001 and the placement
      # column exist to prevent.
      registry_placement=""
      case "$PROJECTS_DIR" in
        /mnt/c/Users/alexa/Projects) ;;
        "${HOME}/Projects")          registry_placement="ext4" ;;
        *)                           registry_placement="$PROJECTS_DIR" ;;
      esac
      if [[ -n "$registry_placement" ]]; then
        printf '%s\t%s\n' "$SLUG" "$registry_placement" >> "$REGISTRY"
        echo "note: added ${SLUG} (${registry_placement}) to current-projects."
      else
        printf '%s\n' "$SLUG" >> "$REGISTRY"
        echo "note: added ${SLUG} to current-projects."
      fi

      # current-projects is tracked in agent-scripts, and this script does not
      # commit it (CLAUDE.md forbids committing unattended). Left dirty,
      # sync-projects skips agent-scripts on every subsequent run with
      # "has uncommitted changes" — the orchestration repo silently stops
      # syncing itself. Say so, with the exact command.
      registry_repo="$(cd -P -- "$(dirname -- "$REGISTRY")" && pwd -P)"
      if git -C "$registry_repo" rev-parse --git-dir >/dev/null 2>&1 \
         && ! git -C "$registry_repo" diff --quiet -- "$REGISTRY"; then
        echo
        warn "${REGISTRY} is now modified and uncommitted."
        warn "sync-projects will skip that repo until you commit it:"
        warn "  git -C ${registry_repo} commit -m 'current-projects: ${PROJECT_NAME}' -- current-projects"
      fi
    fi
  else
    echo "note: current-projects not found at ${REGISTRY}; skipping registration."
  fi
else
  echo "note: local repo created; remote creation skipped (--no-remote)."
fi

echo
echo "Done."
echo "Next:"
echo "  cd \"${TARGET_DIR}\""
echo "  code .   # if VS Code is installed in WSL"
