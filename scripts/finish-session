#!/usr/bin/env bash
# finish-session — close out an agent session: ensure a PR, land it when CI is
# green, and clean up the branch. Symmetric partner to agent-session.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

BASE="main"
TITLE=""
BODY=""
STRATEGY="squash"   # squash | merge | rebase
DRAFT=false
DO_MERGE=true
WAIT=true
TIMEOUT=1800
DRY_RUN=false

usage() {
  cat <<'EOF'
finish-session — open/reuse a PR for the current branch, land it when CI is
green, and clean up.

Usage:
  scripts/finish-session [options]

Options:
  --title TEXT       Override the auto-derived PR title
  --body TEXT        Override the auto-derived PR body
  --base BRANCH      Base branch to merge into (default: main)
  --squash           Squash merge (default)
  --merge            Merge commit instead of squash
  --rebase           Rebase merge instead of squash
  --draft            Open the PR as a draft; do not enable auto-merge
  --no-merge         Ensure the PR exists, but do not enable auto-merge
  --no-wait          Enable auto-merge and return; do not block until merged
  --timeout SECONDS  Give up waiting after this long (default: 1800; 0 = never)
  --dry-run          Print the git/gh commands without executing them
  --help, -h         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)    require_arg_value "$1" "${2:-}"; TITLE="${2:-}"; shift 2 ;;
    --body)     require_arg_value "$1" "${2:-}"; BODY="${2:-}"; shift 2 ;;
    --base)     require_arg_value "$1" "${2:-}"; BASE="${2:-}"; shift 2 ;;
    --squash)   STRATEGY="squash"; shift ;;
    --merge)    STRATEGY="merge"; shift ;;
    --rebase)   STRATEGY="rebase"; shift ;;
    --draft)    DRAFT=true; shift ;;
    --no-merge) DO_MERGE=false; shift ;;
    --no-wait)  WAIT=false; shift ;;
    --timeout)  require_arg_value "$1" "${2:-}"
                [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--timeout wants a whole number of seconds, got: ${2:-}"
                TIMEOUT="${2:-}"; shift 2 ;;
    --dry-run)  DRY_RUN=true; shift ;;
    --help|-h)  usage; exit 0 ;;
    *)          die "unknown argument: $1" ;;
  esac
done

require_cmd git
require_cmd gh

# ── Preconditions ────────────────────────────────────────────────────────────
BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
[[ -n "$BRANCH" ]]         || die "detached HEAD — checkout a feature branch first"
[[ "$BRANCH" != "$BASE" ]] || die "on base branch '${BASE}' — nothing to finish"

if ! git diff --quiet || ! git diff --cached --quiet; then
  die "uncommitted changes — commit or stash before finishing"
fi

ahead="$(git rev-list --count "${BASE}..HEAD" 2>/dev/null || echo 0)"
[[ "$ahead" -gt 0 ]] || die "no commits ahead of '${BASE}' — nothing to land"

# ── Derive PR title/body ─────────────────────────────────────────────────────
derive_title() {
  local topic="${BRANCH##*/}"                                   # last path segment
  topic="${topic#[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-}"    # strip YYYYMMDD-
  topic="${topic//-/ }"                                         # de-slug
  local first="${topic:0:1}"
  printf '%s%s' "$(printf '%s' "$first" | tr '[:lower:]' '[:upper:]')" "${topic:1}"
}

[[ -n "$TITLE" ]] || TITLE="$(derive_title)"
[[ -n "$BODY" ]]  || BODY="$(git log "${BASE}..HEAD" --pretty=format:'- %s')"

merge_flag="--${STRATEGY}"

# ── Dry-run: print the plan from local state only (no gh calls) ───────────────
if [[ "$DRY_RUN" == true ]]; then
  echo "PR title: ${TITLE}"
  echo "[dry-run] git push -u origin ${BRANCH}   (only if no upstream / ahead)"
  echo "[dry-run] gh pr create --base ${BASE} --head ${BRANCH} --title \"${TITLE}\" --body <${ahead} commit(s)>"
  if [[ "$DRAFT" == true ]]; then
    echo "[dry-run] --draft: create draft PR and stop (no auto-merge)"
  elif [[ "$DO_MERGE" == false ]]; then
    echo "[dry-run] --no-merge: ensure PR only (no auto-merge)"
  else
    echo "[dry-run] gh pr merge ${BRANCH} --auto ${merge_flag} --delete-branch"
    if [[ "$WAIT" == true ]]; then
      echo "[dry-run] wait for merge, then: git checkout ${BASE} && git pull --ff-only && git branch -d ${BRANCH}"
    else
      echo "[dry-run] --no-wait: enable auto-merge and return"
    fi
  fi
  exit 0
fi

# ── Ensure pushed (never force) ──────────────────────────────────────────────
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  run git push -u origin "$BRANCH"
elif [[ -n "$(git rev-list '@{upstream}..HEAD' 2>/dev/null)" ]]; then
  run git push
fi

# ── Ensure a PR exists ───────────────────────────────────────────────────────
# Ask for `--json state` rather than the full view. Two reasons: the full view
# renders projectCards, a deprecated GraphQL field that now makes `gh pr view`
# exit non-zero even when the PR exists — which would send us down the create
# path for a PR that is already open. And a MERGED or CLOSED PR is not
# reusable: treating one as "already exists" skips creation and then fails on
# merge, so the new commits are never proposed.
pr_state="$(gh pr view "$BRANCH" --json state --jq .state 2>/dev/null || echo "")"

if [[ "$pr_state" == "OPEN" ]]; then
  echo "PR already exists for ${BRANCH}"
else
  [[ -z "$pr_state" ]] || echo "most recent PR for ${BRANCH} is ${pr_state}; opening a new one"
  if [[ "$DRAFT" == true ]]; then
    run gh pr create --base "$BASE" --head "$BRANCH" --title "$TITLE" --body "$BODY" --draft
  else
    run gh pr create --base "$BASE" --head "$BRANCH" --title "$TITLE" --body "$BODY"
  fi
fi

pr_url="$(gh pr view "$BRANCH" --json url --jq .url 2>/dev/null || echo "")"

if [[ "$DRAFT" == true ]]; then
  echo "Draft PR ready: ${pr_url}"
  echo "Mark it ready, then re-run finish-session to land it."
  exit 0
fi

if [[ "$DO_MERGE" == false ]]; then
  echo "PR ready (auto-merge not enabled): ${pr_url}"
  exit 0
fi

# ── Enable merge-when-green ───────────────────────────────────────────────────
# --auto lands the PR as soon as GitHub considers it mergeable. "Mergeable"
# means CI only if branch protection *requires* a check; on an unprotected
# branch --auto merges immediately and CI is irrelevant. The whole
# merge-when-green story rests on that ruleset existing, so verify it rather
# than assume it.
required_checks="$(gh api "repos/{owner}/{repo}/branches/${BASE}/protection/required_status_checks" \
  --jq '[.contexts[]?, (.checks[]?.context)] | unique | .[]' 2>/dev/null || true)"
grep -qx 'scripts-check' <<<"$required_checks" || die \
  "no required 'scripts-check' check on '${BASE}': --auto would merge without CI.
       Re-run with --no-merge and land it yourself, or protect '${BASE}' first."

run gh pr merge "$BRANCH" --auto "$merge_flag" --delete-branch

if [[ "$WAIT" == false ]]; then
  echo "Auto-merge enabled; lands when '${BASE}' checks pass: ${pr_url}"
  exit 0
fi

# ── Wait for merge, then clean up locally ────────────────────────────────────
echo "Waiting for CI + auto-merge on ${pr_url} ..."
MERGE_CONFIRMED=false
deadline=$(( SECONDS + TIMEOUT ))
while true; do
  state="$(gh pr view "$BRANCH" --json state --jq .state 2>/dev/null || echo "")"
  if [[ "$state" == "MERGED" ]]; then MERGE_CONFIRMED=true; break; fi
  [[ "$state" == "CLOSED" ]] && die "PR was closed without merging: ${pr_url}"

  # --required, and an exact match on the state column. Grepping the whole line
  # for /fail/ matched a check *named* something like `test-failure-modes`, and
  # matched failing non-required checks that auto-merge would happily merge
  # past — either way aborting a land that was going to succeed.
  if gh pr checks "$BRANCH" --required 2>/dev/null | awk -F'\t' '$2=="fail"{found=1} END{exit !found}'; then
    die "required check(s) failing — PR left open: ${pr_url}"
  fi

  # An unbounded `while true` blocks the session forever when CI queues, a
  # runner never picks the job up, or a required reviewer never appears.
  if (( TIMEOUT > 0 && SECONDS >= deadline )); then
    die "timed out after ${TIMEOUT}s waiting for merge — NOT landed.
       Auto-merge is still enabled, so it may land later on its own: ${pr_url}"
  fi
  sleep 10
done

echo "Merged. Cleaning up local branch."
run git checkout "$BASE"
run git pull --ff-only

# A squash merge (the default) rewrites the branch's commits into one new
# commit, so the branch tip is not an ancestor of BASE and `git branch -d`
# refuses. Under set -e that killed the script *after* the PR had merged and
# the remote branch was gone — a successful land reported as a failure.
# Force-delete only when the wait loop actually observed state == MERGED.
# `gh pr merge --delete-branch` already removes the local branch when it can,
# so by this point there is often nothing left to delete. Both -d and -D then
# fail with "branch not found" and set -e turns a clean land into exit 1 —
# the same false failure this block exists to prevent.
if ! git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
  echo "Local branch ${BRANCH} was already removed."
elif ! run git branch -d "$BRANCH"; then
  [[ "$MERGE_CONFIRMED" == true ]] || die \
    "could not delete ${BRANCH} and its merge was never confirmed — leaving it in place"
  warn "squash merge leaves ${BRANCH} unmerged by ancestry; PR is MERGED, deleting"
  run git branch -D "$BRANCH"
fi

echo "Done. ${BRANCH} landed into ${BASE}."
