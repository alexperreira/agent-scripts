#!/usr/bin/env bash
# sync-projects — clone or update all repos listed in current-projects
#
# Usage:
#   scripts/sync-projects [--projects-dir DIR] [--ext4-dir DIR] [--registry FILE]
#                         [--dry-run]
#
# Registry lines are "owner/repo" with an optional placement column:
#   owner/repo              → <projects-dir>/<repo>   (default, /mnt/c)
#   owner/repo<TAB>ext4     → <ext4-dir>/<repo>       ($HOME/Projects)
#   owner/repo<TAB>/a/path  → /a/path/<repo>
#
# The placement column exists because ADR-0001 splits repos across two
# filesystems. Without it every ext4 repo listed here would be cloned a second
# time onto /mnt/c — the divergence that produced wodgenerator and FileParser.
#
# For each entry:
#   - If <root>/<repo> doesn't exist  → git clone
#   - If it does exist                → git pull (on default branch)
#
# Guardrails:
#   - Local main ahead of remote → SKIP pull, print warning
#   - Uncommitted changes        → SKIP pull, print warning
#   - Non-git directory          → SKIP, print warning

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

# ~/Projects is on ext4, where Cowork cannot see it, and cloning there creates a
# second working tree for every repo that already lives on /mnt/c — two copies
# per project, both reporting clean. Override with AGENT_SCRIPTS_PROJECTS_DIR.
PROJECTS_DIR="${AGENT_SCRIPTS_PROJECTS_DIR:-/mnt/c/Users/alexa/Projects}"
# Second root from ADR-0001: build-heavy repos stay on ext4, where inotify fires.
EXT4_DIR="${AGENT_SCRIPTS_EXT4_DIR:-${HOME}/Projects}"
REGISTRY="${SCRIPT_DIR}/../current-projects"
DRY_RUN="false"
GITHUB_BASE="https://github.com"

usage() {
  cat <<'EOF'
sync-projects — clone or pull all repos listed in current-projects

Usage:
  scripts/sync-projects [options]

Options:
  --projects-dir DIR    Base directory for repos with no placement column
                        (default: $AGENT_SCRIPTS_PROJECTS_DIR, else
                        /mnt/c/Users/alexa/Projects)
  --ext4-dir DIR        Base directory for repos marked 'ext4'
                        (default: $AGENT_SCRIPTS_EXT4_DIR, else $HOME/Projects)
  --registry FILE       Path to current-projects file
                        (default: <repo-root>/current-projects)
  --dry-run             Print actions without executing them
  --help, -h            Show this help

Registry format — one entry per line, optional whitespace-separated placement:
  owner/repo              clone into --projects-dir
  owner/repo    ext4      clone into --ext4-dir
  owner/repo    /a/path   clone into an explicit absolute path
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --projects-dir)
      require_arg_value "$1" "${2:-}"
      PROJECTS_DIR="${2:-}"; shift 2 ;;
    --ext4-dir)
      require_arg_value "$1" "${2:-}"
      EXT4_DIR="${2:-}"; shift 2 ;;
    --registry)
      require_arg_value "$1" "${2:-}"
      REGISTRY="${2:-}"; shift 2 ;;
    --dry-run)
      DRY_RUN="true"; shift ;;
    --help|-h)
      usage; exit 0 ;;
    *)
      die "unknown argument: $1" ;;
  esac
done

require_cmd git

[[ -f "$REGISTRY" ]] || die "registry not found: $REGISTRY"

# Counters
cloned=0
pulled=0
uptodate=0
skipped=0
errors=0

# sync_repo is called as `sync_repo ... || ...`, which disables `set -e` for the
# whole function body. Every command that can fail must therefore be checked
# explicitly — a bare failing command here falls through and returns 0.
sync_repo() {
  local slug="$1"          # owner/repo
  local root="$2"          # already-resolved base directory
  local repo_name="${slug##*/}"
  local target="${root}/${repo_name}"
  local clone_url="${GITHUB_BASE}/${slug}.git"

  echo "── ${slug}"

  # ── Clone if missing ────────────────────────────────────────────────────────
  if [[ ! -e "$target" ]]; then
    echo "   → cloning into ${target}"
    if [[ "$DRY_RUN" == "true" ]]; then
      echo "   [dry-run] git clone ${clone_url} ${target}"
      (( cloned++ )) || true
      return 0
    fi
    if ! git clone "${clone_url}" "${target}"; then
      echo "   ⚠ ERROR: clone failed: ${slug}" >&2
      return 1
    fi
    (( cloned++ )) || true
    return 0
  fi

  # ── Existing directory checks ────────────────────────────────────────────────
  if [[ ! -d "${target}/.git" ]]; then
    echo "   ⚠ WARNING: ${target} exists but is not a git repo — skipping" >&2
    (( skipped++ )) || true
    return 0
  fi

  # Confirm this directory is actually the repo the registry names. On /mnt/c —
  # which is case-insensitive — two slugs differing only in case resolve to the
  # SAME directory, so the second one would fetch and fast-forward a repo it
  # does not own. Comparing origin catches that, and any other mismatch.
  local origin_url origin_slug
  origin_url="$(git -C "$target" remote get-url origin 2>/dev/null || echo "")"
  origin_slug="$(printf '%s' "$origin_url" \
    | sed -E 's#^(https?://[^/]+/|git@[^:]+:|ssh://[^/]+/)##; s#\.git$##')"
  if [[ -n "$origin_slug" && "${origin_slug,,}" != "${slug,,}" ]]; then
    echo "   ⚠ WARNING: ${target} has origin '${origin_slug}', not '${slug}' — skipping" >&2
    echo "             Two registry entries differing only in case collide on a" >&2
    echo "             case-insensitive root such as /mnt/c." >&2
    (( skipped++ )) || true
    return 0
  fi

  # Detect current branch
  local branch
  branch=$(git -C "$target" symbolic-ref --short HEAD 2>/dev/null || echo "")
  if [[ -z "$branch" ]]; then
    echo "   ⚠ WARNING: ${target} is in detached HEAD state — skipping" >&2
    (( skipped++ )) || true
    return 0
  fi

  # A leftover .git/index.lock — git through the Cowork bridge can leave one
  # behind — makes every later git write in this repo fail. Skip and say so,
  # rather than letting the failure surface as something less obvious.
  if [[ -e "${target}/.git/index.lock" ]]; then
    echo "   ⚠ WARNING: ${target} has a stale .git/index.lock — skipping" >&2
    echo "             Remove it if no git process is running: ${target}/.git/index.lock" >&2
    (( skipped++ )) || true
    return 0
  fi

  # Check for uncommitted changes (tracked files only)
  if ! git -C "$target" diff --quiet || ! git -C "$target" diff --cached --quiet; then
    echo "   ⚠ WARNING: ${target} has uncommitted changes — skipping pull" >&2
    (( skipped++ )) || true
    return 0
  fi

  # Fetch so we have up-to-date remote refs. Read-only, so it runs in dry-run
  # too: without it the preview reports "already up to date" for every repo
  # that is actually behind.
  if ! git -C "$target" fetch --quiet origin 2>/dev/null; then
    echo "   ⚠ WARNING: fetch failed for ${target} — skipping" >&2
    (( skipped++ )) || true
    return 0
  fi

  # Check if remote tracking branch exists
  local remote_ref="origin/${branch}"
  if ! git -C "$target" rev-parse --verify "${remote_ref}" >/dev/null 2>&1; then
    echo "   ⚠ WARNING: no remote tracking branch '${remote_ref}' — skipping pull" >&2
    (( skipped++ )) || true
    return 0
  fi

  # Compare local vs remote
  # Unguarded command substitutions would leave these empty on failure, and an
  # empty SHA compares unequal to everything — the repo would be misreported as
  # diverged rather than errored.
  local local_sha remote_sha merge_base
  local_sha=$(git -C "$target" rev-parse HEAD) || {
    echo "   ⚠ ERROR: cannot resolve HEAD in ${target}" >&2; return 1; }
  remote_sha=$(git -C "$target" rev-parse "${remote_ref}") || {
    echo "   ⚠ ERROR: cannot resolve ${remote_ref} in ${target}" >&2; return 1; }
  merge_base=$(git -C "$target" merge-base HEAD "${remote_ref}") || {
    echo "   ⚠ ERROR: no common ancestor between HEAD and ${remote_ref} in ${target}" >&2; return 1; }

  if [[ "$local_sha" == "$remote_sha" ]]; then
    echo "   ✓ already up to date"
    (( uptodate++ )) || true
    return 0
  fi

  if [[ "$merge_base" == "$remote_sha" ]]; then
    # Local is ahead of remote (remote hasn't seen our commits)
    local ahead
    ahead=$(git -C "$target" rev-list --count "${remote_ref}..HEAD") || ahead="?"
    echo "   ⚠ WARNING: local '${branch}' is ${ahead} commit(s) ahead of remote — skipping pull" >&2
    echo "             Push or PR from ${target} to sync." >&2
    (( skipped++ )) || true
    return 0
  fi

  if [[ "$merge_base" == "$local_sha" ]]; then
    # Fast-forward available
    echo "   → pulling ${branch}"
    if [[ "$DRY_RUN" == "true" ]]; then
      echo "   [dry-run] git -C ${target} pull --ff-only --quiet origin ${branch}"
      (( pulled++ )) || true
      return 0
    fi
    if ! git -C "$target" pull --ff-only --quiet origin "${branch}"; then
      echo "   ⚠ ERROR: pull failed: ${target}" >&2
      return 1
    fi
    (( pulled++ )) || true
    return 0
  fi

  # Diverged
  echo "   ⚠ WARNING: ${target} has diverged from remote — skipping pull" >&2
  echo "             Resolve manually: cd ${target} && git status" >&2
  (( skipped++ )) || true
  return 0
}

echo "Registry: ${REGISTRY}"
echo "Projects: ${PROJECTS_DIR}"
echo "ext4:     ${EXT4_DIR}"
[[ "$DRY_RUN" == "true" ]] && echo "Mode:     dry-run"
echo

# ── Parse the registry ────────────────────────────────────────────────────────
# Two passes. The first resolves every entry to a concrete directory so that
# collisions can be reported up front; the second does the work. Parsing must
# not strip interior whitespace, because that is the placement separator.
#
# `|| [[ -n "$line" ]]` keeps the last entry when the registry has no trailing
# newline — otherwise read returns non-zero and that repo is silently dropped.
declare -a SLUGS=() ROOTS=()
lineno=0
parse_errors=0

resolve_root() {
  case "$1" in
    "")     printf '%s' "$PROJECTS_DIR" ;;
    ext4)   printf '%s' "$EXT4_DIR" ;;
    win)    printf '%s' "$PROJECTS_DIR" ;;
    /*)     printf '%s' "$1" ;;
    *)      return 1 ;;
  esac
}

while IFS= read -r line || [[ -n "$line" ]]; do
  (( lineno++ )) || true
  line="${line%%#*}"
  # Trim leading and trailing whitespace, but keep the interior intact.
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue

  slug="${line%%[[:space:]]*}"
  placement="${line#"$slug"}"
  placement="${placement#"${placement%%[![:space:]]*}"}"
  # Only the first token is the placement; anything after it is a typo, not a
  # third column. Saying so beats silently honouring half the line.
  if [[ "$placement" == *[[:space:]]* ]]; then
    warn "registry line ${lineno}: unexpected extra field in '${line}' — skipping"
    (( parse_errors++ )) || true
    continue
  fi

  if ! root="$(resolve_root "$placement")"; then
    warn "registry line ${lineno}: unknown placement '${placement}' for ${slug} — skipping"
    warn "expected 'ext4', 'win', or an absolute path."
    (( parse_errors++ )) || true
    continue
  fi

  SLUGS+=("$slug")
  ROOTS+=("$root")
done < "$REGISTRY"

# A case-insensitive root (/mnt/c) maps two slugs differing only in case onto one
# directory. Only entries sharing a root can collide, so key on root + name —
# the same repo name under two different roots is legitimate.
declare -A seen_targets=()
for i in "${!SLUGS[@]}"; do
  name="${SLUGS[$i]##*/}"
  key="${ROOTS[$i]}/${name,,}"
  if [[ -n "${seen_targets[$key]:-}" ]]; then
    warn "registry has more than one entry resolving to '${key}' (case-insensitive);"
    warn "on that root they share one directory."
  fi
  seen_targets["$key"]=1
done

for i in "${!SLUGS[@]}"; do
  sync_repo "${SLUGS[$i]}" "${ROOTS[$i]}" || (( errors++ )) || true
done

(( errors += parse_errors )) || true

echo
echo "Done. cloned=${cloned} updated=${pulled} up-to-date=${uptodate} skipped=${skipped} errors=${errors}"
[[ $errors -eq 0 ]] || exit 1
